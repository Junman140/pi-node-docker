set -e

export DEBIAN_FRONTEND=noninteractive
apt-get -y install gnupg rsync wget webfs

mkdir -p /etc/apt/keyrings
wget -qO - https://apt.stellar.org/SDF.asc | gpg --dearmor -o /etc/apt/keyrings/SDF.gpg
echo "deb [signed-by=/etc/apt/keyrings/SDF.gpg] https://apt.stellar.org noble stable" >/etc/apt/sources.list.d/SDF.list
echo "deb [signed-by=/etc/apt/keyrings/SDF.gpg] https://apt.stellar.org noble unstable" >/etc/apt/sources.list.d/SDF-unstable.list
apt-get update
apt-get install -y stellar-core=${STELLAR_CORE_VERSION}
apt-get install -y stellar-horizon=${HORIZON_VERSION}
apt-get install -y stellar-archivist
apt-get clean
echo "\nDone installing stellar-core, horizon, and stellar-archivist\n"
